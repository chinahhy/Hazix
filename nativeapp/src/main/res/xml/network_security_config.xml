<?xml version="1.0" encoding="utf-8"?>
<!--
  Everything the app fetches — the release APK on github.com and the catalogue
  and media from the content host — is served over HTTPS, so cleartext HTTP is
  refused for every host. This file replaces the old blanket
  android:usesCleartextTraffic="false" and keeps the policy explicit in one
  place: no <domain-config> block is present, and none should be added for an
  update source, because the updater only ever talks to GitHub.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
